# =====================================================================
# UPS Web Dashboard - Environment Configuration Template
# Copy this file to data/.env and adjust the values for your NUT server.
# Settings can also be modified at runtime via the Web UI Settings modal.
# =====================================================================

# Hostname or IP address of the NUT upsd daemon
NUT_HOST=host.docker.internal

# TCP port of the NUT upsd daemon (standard default: 3493)
NUT_PORT=3493

# UPS identifier defined in NUT's ups.conf
UPS_NAME=ups

# Optional NUT daemon credentials (leave empty if not required)
# NUT_USER=upsmon
# NUT_PASSWORD=

# Port exposed on the host for the web dashboard
PORT=8080

# Background NUT polling interval in seconds (minimum: 0.5)
POLL_INTERVAL=2.0

# Optional dashboard access password (leave empty for open LAN access)
# DASHBOARD_PASSWORD=
