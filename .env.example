# =====================================================================
# CONFIGURATION SETTINGS (.env.example)
# Copy this file to .env and configure your parameters:
#   cp .env.example .env
# =====================================================================

# Network address of the NUT (Network UPS Tools) server
# (Use host IP, server IP, or container hostname if on shared docker network)
NUT_HOST=127.0.0.1
NUT_PORT=3493

# Identifier of the UPS configured in NUT (e.g. 'ups', 'apc950')
UPS_NAME=ups

# Optional NUT credentials (if upsd requires authentication)
NUT_USER=
NUT_PASSWORD=

# Web server port to expose on the host
PORT=8080

# Telemetry polling interval in seconds
POLL_INTERVAL=2.0

# Optional dashboard password protection.
# Leave blank for open access, or specify a password to protect the dashboard:
DASHBOARD_PASSWORD=
